{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 $HOME/agent-ops/hooks/guard_bash.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/agent-ops/hooks/stop_gate.py",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
